# ─────────────────────────────────────────────────────────────
# Variables de entorno para DOCKER COMPOSE (las lee automáticamente
# el archivo docker-compose.yml de esta carpeta).
# Cópialo como `.env` y edita los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (contenedor papeleria-db)
POSTGRES_USER="papeleria"
POSTGRES_PASSWORD="cambia-esta-contrasena"
POSTGRES_DB="papeleria_db"
POSTGRES_PORT="5433"

# Panel pgAdmin4 (contenedor papeleria-pgadmin)
PGADMIN_DEFAULT_EMAIL="admin@papeleria.local"
PGADMIN_DEFAULT_PASSWORD="cambia-este-password-admin"
PGADMIN_PORT="5050"

# ─────────────────────────────────────────────────────────────
# Variables para la APLICACIÓN (apps/web/.env) y para PRISMA
# (packages/database/.env). El password debe coincidir con
# POSTGRES_PASSWORD de arriba.
# ─────────────────────────────────────────────────────────────
# Ejemplo:
#   postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public
DATABASE_URL="postgresql://papeleria:cambia-esta-contrasena@localhost:5433/papeleria_db?schema=public"

# JWT (usa una clave larga y aleatoria en producción: por ejemplo `openssl rand -base64 48`)
JWT_SECRET="cambia-este-secreto-jwt"
JWT_EXPIRES_IN="8h"

# Next.js
NEXTAUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"