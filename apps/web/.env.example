# Base de datos
DATABASE_URL="postgresql://user:password@localhost:5432/papeleria_db?schema=public"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# App
NODE_ENV="development"

# JWT (mismo par que usa el login propio)
JWT_SECRET="cambia-esto-en-produccion"
JWT_EXPIRES_IN="8h"

# ============================================================
# FASE 12 · Imágenes de producto (Cloudinary)
# Solo los dos valores NEXT_PUBLIC_ son necesarios para la subida
# "unsigned" desde el navegador; también se acepta CLOUDINARY_URL
# con las credenciales de la API para administration.
# Deja el flag `imagenesCloudinary` apagado si no los vas a usar.
# ============================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-nube"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="preset-unsigned"
# Credenciales de la API (solo servidor; nunca se envían al cliente):
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@tu-nube"
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Carpeta destino opcional:
# CLOUDINARY_FOLDER="papeleria/productos"

# Multi-tenant: clave de la consola de PLATAFORMA (dueño del sistema) en
# /plataforma: alta de negocios por giro, suspensión y restablecer claves.
# También protege POST /api/negocios (encabezado x-plataforma-token).
# Mínimo 24 caracteres; si se deja vacía, la consola queda deshabilitada.
PLATAFORMA_TOKEN=""

# ============================================================
# FASE H · Preparación para vender (todo opcional)
# ============================================================
# Correo (SMTP) para "¿Olvidaste tu contraseña?". Sin SMTP_HOST el sistema
# funciona igual y la recuperación la hace la administradora.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="avisos@midominio.com"
# SMTP_PASS="contraseña-de-aplicacion"
# CORREO_REMITENTE="Mi POS <avisos@midominio.com>"
# Dirección pública para armar los enlaces de los correos:
# URL_PUBLICA="https://pos.midominio.com"

# Contacto de soporte (se muestra en el login y en el Ayudante):
# SOPORTE_WHATSAPP="5215512345678"
# SOPORTE_CORREO="soporte@midominio.com"
# SOPORTE_HORARIO="Lunes a sábado de 9 a 19 h"

# Responsable del aviso de privacidad y los términos (/privacidad, /terminos):
# LEGAL_RESPONSABLE="Nombre o razón social"
# LEGAL_DOMICILIO="Calle, número, colonia, municipio, estado, CP"
# LEGAL_CORREO="privacidad@midominio.com"

# Respaldos del servidor (npm run db:respaldo):
# RESPALDOS_DIR="D:\OneDrive\Respaldos POS"
# RESPALDOS_CONSERVAR="14"
