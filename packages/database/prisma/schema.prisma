generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Rol {
  ADMINISTRADORA
  CAJERA
}

enum EstadoVenta {
  ACTIVA
  COMPLETADA
  CANCELADA
  REEMBOLSADA
}

enum TipoImpresion {
  BLANCO_NEGRO
  COLOR
  PLOTTER
}

// Plantilla Universal (Fase 10): el motor ya no es exclusivo de papelerías.
// PAPELERIA_RETAIL / ABARROTES / SERVICIOS / MIXTO coexistían; se suman las
// verticales comerciales típicas de la plantilla agnóstica.
enum TipoNegocio {
  PAPELERIA_RETAIL
  ABARROTES
  SERVICIOS
  MIXTO
  FERRETERIA
  FARMACIA
  BOUTIQUE
}

// Sistema de Apartados (Fase 10): el cliente reserva mercancía con un
// anticipo y la liquidación cierra la venta.
enum EstadoApartado {
  PENDIENTE
  LIQUIDADO
  CANCELADO
}

enum EstadoSesionCaja {
  ABIERTA
  EN_CIERRE
  CERRADA
  // Fase 10 · Auditoría de Caja: la sesión se invalida SIN borrar el registro.
  // Se conservan la pista de auditoría y los totales; los reportes de
  // ingresos excluyen las sesiones ANULADA.
  ANULADA
}

enum ModuloSistema {
  PUNTO_VENTA
  INVENTARIO
  CAJA
  REPORTES
  CONFIGURACION
  BITACORA
  CARGA_MASIVA
  SYNC
  SETUP
  SEGURIDAD
}

enum TipoDevolucion {
  DEVOLUCION
  NOTA_CREDITO
}

enum TipoMovimientoKardex {
  ENTRADA
  SALIDA
  AJUSTE
}

// ============================================================
// TABLAS
// ============================================================

model Usuario {
  idPersona          String    @id @default(uuid())
  nombre             String
  username           String    @unique
  passwordHash       String
  rol                Rol       @default(CAJERA)
  activa             Boolean   @default(true)
  // ---- Seguridad Root (Fase 3) ----
  // Única persona habilitada para acciones destructivas del sistema
  // (Factory Reset/restauración de snapshots).
  isRoot             Boolean   @default(false)
  // ---- Permisos Granulares (Fase 9 / ABAC) ----
  // Control fino por módulo sobre el rol base (CAJERA por defecto con todo
  // activo: no rompe usuarios existentes; la administradora los administra).
  permisoCobrar      Boolean   @default(true)
  permisoInventario  Boolean   @default(true)
  permisoReportes    Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  ultimoLoginAt      DateTime?
  passwordCambiadaEn DateTime?

  ventas             Venta[]
  sesionesCaja       SesionCaja[]
  bitacoraLogs       BitacoraLog[]
  pedidosProveedor   PedidoProveedor[]
  configActualizada  ConfiguracionNegocio[]
  cierresIniciados   SesionCaja[]           @relation("CierreIniciadoPor")
  devoluciones       Devolucion[]
  pagosProveedor     PagoProveedor[]
  snapshotsSeguridad SnapshotSeguridad[]    @relation("SnapshotCreadoPor")
  retirosAutorizados RetiroEfectivo[]       @relation("RetiroAutorizadoPor")
  movimientosKardex  MovimientoKardex[]
  apartadosCreados   Apartado[]
  facturasEmitidas   Factura[]

  @@map("usuarios")
}

model Producto {
  codigoItem         String         @id
  descripcion        String
  precioUnitario     Decimal        @db.Decimal(10, 2)
  precioCompra       Decimal?       @db.Decimal(10, 2)
  // ---- Fase 12 · Venta a Mayoreo ----
  // Precio de mayoreo (opcional). Si es null o 0, el producto NO tiene
  // precio de mayoreo y el interruptor del POS lo omite (usa menudeo).
  precioMayoreo      Decimal?       @db.Decimal(10, 2)
  // ---- Fase 12 · Imágenes Cloudinary ----
  // URL pública de la imagen en Cloudinary (o data URI). Solo se usa cuando
  // el feature flag `imagenesCloudinary` está activo en Configuración.
  imagenUrl          String?        @db.Text
  // ---- Fase 10 · Plantilla Universal ----
  // Ventas a granel: el carrito y el ticket aceptan fracciones (0.5 kg, 8 m).
  // El stock se modela en Decimal(10,3) para poder rastrear kilos/metros.
  stockActual        Decimal        @default(0) @db.Decimal(10, 3)
  stockMinimo        Decimal        @default(5) @db.Decimal(10, 3)
  // true = se vende por kilo/metro/litro (permitido decimal) o por unidad
  // fraccionable; false = solo unidades enteras (comportamiento Fase 1-9).
  permiteDecimales   Boolean        @default(false)
  // true = servicio: se vende SIN exigir ni descontar stock (recargas,
  // consultas, copias, instalaciones) y NO genera movimiento físico Kardex.
  esServicio         Boolean        @default(false)
  // Categoría del negocio (plantilla universal); nulo = "Sin categoría".
  idCategoria        String?
  ubicacionEstante   String?
  // ---- Configuración Personalizable del Inventario (Fase 10) ----
  // Fecha de caducidad (lotes de corta vida: farmacia/abarrotes). Solo
  // visible/editable cuando el toggle `usarCaducidad` está activo en
  // Configuración → Inventario.
  fechaCaducidad     DateTime?
  tipoImpresion      TipoImpresion?
  proveedor          String?
  codigoBarras       String?        @unique
  activo             Boolean        @default(true)
  // Destacado para el catálogo visual del POS (grid táctil "más vendidos / favoritos").
  favorito           Boolean        @default(false)
  fechaCreacion      DateTime       @default(now())
  fechaActualizacion DateTime       @updatedAt

  categoria         Categoria?            @relation(fields: [idCategoria], references: [id])
  lineasDetalle     LineaDetalleVenta[]
  itemsPedido       ItemPedidoProveedor[]
  devolucionLineas  DevolucionLinea[]
  kardexMovimientos MovimientoKardex[]
  apartadoLineas    ApartadoLinea[]

  @@index([idCategoria])
  @@map("productos")
}

// Catálogo de categorías por negocio (Fase 10). `idNegocio` es la llave de
// arrendatario (multi-tenant) para el futuro multiedición SaaS; hoy siempre
// "default".
model Categoria {
  id        String @id @default(uuid())
  nombre    String
  color     String @default("#6366f1")
  idNegocio String @default("default")

  productos Producto[]

  @@index([idNegocio])
  @@map("categorias")
}

model Proveedor {
  idProveedor   String   @id @default(uuid())
  nombre        String
  telefono      String?
  email         String?
  direccion     String?
  contacto      String?
  limiteCredito Decimal? @db.Decimal(10, 2)
  saldoCredito  Decimal? @default(0) @db.Decimal(10, 2)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())

  pedidos PedidoProveedor[]
  pagos   PagoProveedor[]

  @@map("proveedores")
}

model PedidoProveedor {
  idPedido      String    @id @default(uuid())
  idProveedor   String
  fechaPedido   DateTime  @default(now())
  fechaEntrega  DateTime?
  totalEstimado Decimal   @db.Decimal(10, 2)
  estado        String    @default("PENDIENTE")
  notas         String?
  createdBy     String

  proveedor Proveedor             @relation(fields: [idProveedor], references: [idProveedor])
  usuario   Usuario               @relation(fields: [createdBy], references: [idPersona])
  items     ItemPedidoProveedor[]

  @@index([idProveedor])
  @@map("pedidos_proveedor")
}

model ItemPedidoProveedor {
  idItemPedido   String  @id @default(uuid())
  idPedido       String
  codigoItem     String
  cantidad       Int
  precioCotizado Decimal @db.Decimal(10, 2)

  pedido   PedidoProveedor @relation(fields: [idPedido], references: [idPedido])
  producto Producto        @relation(fields: [codigoItem], references: [codigoItem])

  @@index([idPedido])
  @@map("items_pedido_proveedor")
}

model Venta {
  folioVenta              String      @id
  fechaHora               DateTime    @default(now())
  subtotal                Decimal     @db.Decimal(10, 2)
  iva                     Decimal     @db.Decimal(10, 2)
  totalNeto               Decimal     @db.Decimal(10, 2)
  idUsuario               String
  idCaja                  String?
  // ---- CRM y fidelización ----
  // Cliente asociado al ticket. Con PUNTOS_MONEDERO es obligatorio (dueño
  // del monedero); en los demás métodos es opcional y solo acumula puntos.
  idCliente               String?
  estado                  EstadoVenta @default(ACTIVA)
  metodoPago              String      @default("EFECTIVO")
  // ---- Blindaje Financiero (Fase 2) ----
  // Últimos 4+ dígitos de la referencia/rastreo de la transferencia,
  // exigidos por el POS cuando el cobro es por transferencia (DIGITAL).
  referenciaTransferencia String?     @db.Text
  createdAt               DateTime    @default(now())
  // ---- Offline-first (idempotencia + traza de origen) ----
  idLocal                 String?     @unique
  // "ONLINE" | "OFFLINE" (sincronizada) | "APARTADO" (liquidación de apartado)
  origen                  String      @default("ONLINE")
  dispositivoId           String?
  fechaHoraCliente        DateTime?

  usuario       Usuario             @relation(fields: [idUsuario], references: [idPersona])
  sesionCaja    SesionCaja?         @relation(fields: [idCaja], references: [idCaja])
  cliente       Cliente?            @relation(fields: [idCliente], references: [idCliente])
  lineasDetalle LineaDetalleVenta[]
  devoluciones  Devolucion[]
  // Fase 12: un ticket genera como máximo una factura.
  factura       Factura?

  // Reportes, dashboard y corte filtran por fecha, caja y cliente.
  @@index([fechaHora])
  @@index([idCaja])
  @@index([idCliente])
  @@index([estado, fechaHora])
  @@map("ventas")
}

model LineaDetalleVenta {
  idLinea        String  @id @default(uuid())
  folioVenta     String
  codigoItem     String
  // Fase 10: Decimal para ventas a granel (0.5 kg); las unidades enteras
  // se siguen escribiendo como 1, 2, 3...
  cantidad       Decimal @db.Decimal(10, 3)
  precioMomento  Decimal @db.Decimal(10, 2)
  descuentoLinea Decimal @default(0) @db.Decimal(10, 2)
  subtotalLinea  Decimal @db.Decimal(10, 2)

  venta    Venta    @relation(fields: [folioVenta], references: [folioVenta])
  producto Producto @relation(fields: [codigoItem], references: [codigoItem])

  @@index([folioVenta])
  @@index([codigoItem])
  @@map("lineas_detalle_venta")
}

model SesionCaja {
  idCaja              String           @id @default(uuid())
  // ---- Folios Amigables (Fase 9) ----
  // Identificador legible para reportes e impresiones (ej. "CAJA-001")
  // en lugar del UUID interno. Se asigna en la apertura de caja.
  folioCaja           String?          @unique
  // ---- Multi-Caja (Fase 3) ----
  // Identificador humano del terminal físico (ej. "Caja 1", "Terminal 2").
  nombreCaja          String?
  idUsuario           String
  fondoInicial        Decimal          @db.Decimal(10, 2)
  totalVentasEfectivo Decimal          @default(0) @db.Decimal(10, 2)
  totalVentasDigital  Decimal          @default(0) @db.Decimal(10, 2)
  totalRecargas       Decimal          @default(0) @db.Decimal(10, 2)
  totalEgresos        Decimal          @default(0) @db.Decimal(10, 2)
  horaApertura        DateTime         @default(now())
  horaCierre          DateTime?
  estado              EstadoSesionCaja @default(ABIERTA)
  notasCierre         String?
  // ---- Auditoría de Caja (Fase 10) ----
  // Motivo obligatorio al anular una sesión (estado ANULADA); el registro,
  // las ventas y los totales se conservan intactos para la pista de auditoría.
  motivoAnulacion     String?
  // ---- Corte ciego (máquina de estados anti-evasión) ----
  cierreToken         String?
  cierreInicioEn      DateTime?
  cierreIniciadoPor   String?
  efectivoContado     Decimal?         @db.Decimal(10, 2)
  vouchersContado     Decimal?         @db.Decimal(10, 2)
  recargasContado     Decimal?         @db.Decimal(10, 2)
  faltanteTotal       Decimal?         @db.Decimal(10, 2)
  descuadre           Boolean          @default(false)

  usuario        Usuario          @relation(fields: [idUsuario], references: [idPersona])
  cierreIniciado Usuario?         @relation("CierreIniciadoPor", fields: [cierreIniciadoPor], references: [idPersona])
  ventas         Venta[]
  devoluciones   Devolucion[]
  retiros        RetiroEfectivo[]
  apartados      Apartado[]

  // "La caja ABIERTA" se consulta en cada venta.
  @@index([estado])
  @@map("sesiones_caja")
}

model ConfiguracionNegocio {
  id                    Int         @id @default(1)
  nombreNegocio         String      @default("Mi Negocio")
  tipoNegocio           TipoNegocio @default(PAPELERIA_RETAIL)
  moneda                String      @default("MXN")
  ivaRate               Decimal     @default(16) @db.Decimal(5, 2)
  // Feature flags { inventario: boolean; facturacion: boolean; dashboard: boolean; ... }
  featureFlags          Json        @default("{}")
  // Metodos de pago habilitados ["EFECTIVO","TARJETA_TERMINAL","TRANSFERENCIA"]
  metodosPago           Json        @default("[]")
  politicaStockOffline  String      @default("PERMITIR_NEGATIVO")
  // ---- Marca Blanca / Temas (Fase 1 → Fase 3) ----
  // Logo del negocio: data URI base64 (máx 1 MB, validado en API) o URL.
  logo                  String?     @db.Text
  // Tema base visual del sistema: "NEON" | "MINIMALISTA" | "BRUTALISTA" | "CORPORATIVO".
  // BrandTheme inyecta data-theme="<temaBase>" en <html> y las variables
  // semánticas de Tailwind (bg-surface, border-base, shadow-card) cambian
  // sus valores CSS nativos según el tema.
  temaBase              String      @default("NEON")
  // Color de acento (hex #rrggbb) para botones principales y acentos (antes temaColor).
  colorAcento           String      @default("#10b981")
  // ---- Hiper-personalización (Fase de Pulido / Fase 4) ----
  // Texto opcional al final del ticket (políticas de devolución, gracias, etc.).
  mensajeTicket         String?
  // Ancho del ticket térmico: "58mm" | "80mm" (clase CSS del recibo).
  anchoTicket           String      @default("80mm")
  // Vista inicial del POS: "ESCANER" (input enfocado) | "CATALOGO_TACTIL" (grid).
  vistaDefectoPOS       String      @default("ESCANER")
  // Datos fiscales para facturación (RFC, Razón Social, Régimen Fiscal y CP).
  // Ej: { rfc: string; razonSocial: string; regimenFiscal: string; codigoPostal: string }
  datosFiscales         Json?
  // ---- Blindaje Financiero (Fase 2) ----
  // Cuenta de transferencia del negocio para cobros PPG/pagaré, ej.
  // { banco: string; titular: string; clabe: string; cuenta: string }
  // Administrada por el Admin desde Configuración; el POS la muestra en
  // el modal de pago "Transferencia" exigiendo los últimos 4 dígitos de
  // la referencia/rastreo.
  datosBancarios        Json?
  // ---- Configuración Personalizable del Inventario (Fase 10) ----
  // Toggles para el Inventario: caducidad (lotes) y ubicaciones de estante.
  // Apagar una opción oculta su columna/campo en la UI sin perder datos
  // históricos de los productos.
  usarCaducidad         Boolean     @default(false)
  usarUbicaciones       Boolean     @default(true)
  // ---- Configuración de Caja (Fase 10) ----
  // true = la apertura de caja exige capturar el fondo inicial (por defecto).
  // false = la caja puede abrirse sin fondo (caja de puesto rápido en ferias).
  requerirFondoInicial  Boolean     @default(true)
  // ---- Puntos Monedero (Fase 12) ----
  // Tasa del programa de fidelización: cuánto gastar para ganar 1 punto y
  // cuánto cubre 1 punto al pagar. Ej: { pesosCompraPorPunto: 100, valorPuntoPesos: 1 }
  puntosConfig          Json?
  configVersion         Int         @default(1)
  setupPendiente        Boolean     @default(true)
  updatedById           String?
  updatedAt             DateTime    @updatedAt

  updatedBy Usuario? @relation(fields: [updatedById], references: [idPersona])

  @@map("configuracion_negocio")
}

model SnapshotSeguridad {
  id        String   @id @default(uuid())
  fecha     DateTime @default(now())
  // Estado completo (configuración + totales por sesión de caja) en JSON,
  // capturado ANTES de un reinicio del sistema para permitir restauración.
  datosJson Json
  motivo    String
  // Quién originó el snapshot (la única persona que puede reiniciar).
  idUsuario String?

  usuario Usuario? @relation("SnapshotCreadoPor", fields: [idUsuario], references: [idPersona])

  @@index([fecha])
  @@index([idUsuario])
  @@map("snapshots_seguridad")
}

model BitacoraLog {
  idLog         String        @id @default(uuid())
  fechaHora     DateTime      @default(now())
  idUsuario     String?
  accion        String
  moduloSistema ModuloSistema
  jsonPayload   Json?
  detallesError String?
  ipOrigen      String?

  usuario Usuario? @relation(fields: [idUsuario], references: [idPersona])

  @@index([fechaHora])
  @@index([moduloSistema])
  @@index([idUsuario])
  @@map("bitacora_logs")
}

model Devolucion {
  idDevolucion    String         @id @default(uuid())
  folioDevolucion String         @unique
  folioVenta      String
  fechaHora       DateTime       @default(now())
  tipo            TipoDevolucion @default(DEVOLUCION)
  motivo          String?
  subtotal        Decimal        @db.Decimal(10, 2)
  iva             Decimal        @db.Decimal(10, 2)
  totalNeto       Decimal        @db.Decimal(10, 2)
  metodoReembolso String         @default("EFECTIVO")
  idUsuario       String
  idCaja          String?
  createdAt       DateTime       @default(now())

  venta      Venta             @relation(fields: [folioVenta], references: [folioVenta])
  usuario    Usuario           @relation(fields: [idUsuario], references: [idPersona])
  sesionCaja SesionCaja?       @relation(fields: [idCaja], references: [idCaja])
  lineas     DevolucionLinea[]

  @@index([folioVenta])
  @@map("devoluciones")
}

model DevolucionLinea {
  idLineaDevolucion String  @id @default(uuid())
  idDevolucion      String
  codigoItem        String
  // Fase 10: Decimal para devolver fracciones de granel.
  cantidad          Decimal @db.Decimal(10, 3)
  precioMomento     Decimal @db.Decimal(10, 2)
  subtotalLinea     Decimal @db.Decimal(10, 2)

  devolucion Devolucion @relation(fields: [idDevolucion], references: [idDevolucion])
  producto   Producto   @relation(fields: [codigoItem], references: [codigoItem])

  @@index([idDevolucion])
  @@map("devolucion_lineas")
}

model PagoProveedor {
  idPago      String   @id @default(uuid())
  idProveedor String
  fechaHora   DateTime @default(now())
  monto       Decimal  @db.Decimal(10, 2)
  metodoPago  String   @default("EFECTIVO")
  referencia  String?
  notas       String?
  idUsuario   String
  createdAt   DateTime @default(now())

  proveedor Proveedor @relation(fields: [idProveedor], references: [idProveedor])
  usuario   Usuario   @relation(fields: [idUsuario], references: [idPersona])

  @@index([idProveedor])
  @@map("pagos_proveedor")
}

// ============================================================
// FASE 3 — CRM · Kardex · Multi-Caja
// ============================================================

// Cliente del sistema de cuentas por cobrar (Crédito de Tienda) y
// programa de fidelización (1 punto por cada $100 de compra).
model Cliente {
  idCliente       String   @id @default(uuid())
  nombre          String
  telefono        String?
  saldoDeudor     Decimal  @default(0) @db.Decimal(10, 2)
  puntosFidelidad Int      @default(0)
  // ---- Fase 12 · Facturación estricta ----
  // Datos fiscales del receptor del CFDI. Opcionales en el padrón (el POS
  // solo necesita nombre), pero se exigen al emitir la factura.
  rfc             String?
  razonSocial     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ventas    Venta[]
  apartados Apartado[]
  facturas  Factura[]

  @@map("clientes")
}

// ============================================================
// FASE 12 — Facturación estricta (CFDI 4.0)
// ============================================================

enum EstadoFactura {
  EMITIDA
  CANCELADA
}

// Una factura está siempre atada a UN cliente registrado y a UN ticket de
// compra existente (folioVenta es único: no se puede facturar dos veces el
// mismo ticket). Los importes se copian del ticket en el momento de emitir.
model Factura {
  idFactura    String        @id @default(uuid())
  folio        String        @unique
  fechaEmision DateTime      @default(now())
  idCliente    String
  folioVenta   String        @unique
  subtotal     Decimal       @db.Decimal(10, 2)
  iva          Decimal       @db.Decimal(10, 2)
  totalNeto    Decimal       @db.Decimal(10, 2)
  metodoPago   String
  usoCfdi      String        @default("S01")
  formaPago    String        @default("PUE")
  estado       EstadoFactura @default(EMITIDA)
  idUsuario    String
  createdAt    DateTime      @default(now())

  cliente Cliente @relation(fields: [idCliente], references: [idCliente])
  venta   Venta   @relation(fields: [folioVenta], references: [folioVenta])
  usuario Usuario @relation(fields: [idUsuario], references: [idPersona])

  @@index([idCliente])
  @@index([fechaEmision])
  @@map("facturas")
}

// ============================================================
// FASE 10 — Sistema de Apartados (Layaways)
// ============================================================

// El cliente "aparta" mercancía que aún no paga: deja un anticipo (que
// ingresa a la SesionCaja como efectivo/digital) y el stock queda reservado
// (descuento físico inmediato). La venta se materializa al liquidar.
model Apartado {
  idApartado       String         @id @default(uuid())
  // Folio legible para operación e impresión (ej. "APT-0001").
  folio            String         @unique
  idCliente        String
  // Caja donde ingresó el anticipo (puede ser null si se crea sin caja).
  idCaja           String?
  // Anticipo inicial (entra a la caja) y saldo pendiente por monitorización.
  anticipo         Decimal        @db.Decimal(10, 2)
  total            Decimal        @db.Decimal(10, 2)
  estado           EstadoApartado @default(PENDIENTE)
  fechaCreado      DateTime       @default(now())
  fechaLiquidacion DateTime?
  notas            String?
  idUsuario        String
  createdAt        DateTime       @default(now())

  cliente    Cliente         @relation(fields: [idCliente], references: [idCliente])
  sesionCaja SesionCaja?     @relation(fields: [idCaja], references: [idCaja])
  usuario    Usuario         @relation(fields: [idUsuario], references: [idPersona])
  lineas     ApartadoLinea[]

  @@index([idCliente])
  @@index([estado])
  @@map("apartados")
}

// Líneas del apartado: mismas reglas que la venta (Producto + cantidad
// Decimal para granel), pero el subtotal guarda el precio acordado.
model ApartadoLinea {
  idLineaApartado String  @id @default(uuid())
  idApartado      String
  codigoItem      String
  cantidad        Decimal @db.Decimal(10, 3)
  precioMomento   Decimal @db.Decimal(10, 2)
  descuentoLinea  Decimal @default(0) @db.Decimal(10, 2)
  subtotalLinea   Decimal @db.Decimal(10, 2)

  apartado Apartado @relation(fields: [idApartado], references: [idApartado])
  producto Producto @relation(fields: [codigoItem], references: [codigoItem])

  @@index([idApartado])
  @@map("apartado_lineas")
}

// Kardex de inventario INMUTABLE: toda variación de stock (venta,
// devolución, carga masiva, ajuste, pedido) genera EXACTAMENTE un
// registro aquí; nunca se toca `stockActual` sin su trazo.
model MovimientoKardex {
  idMovimiento   String               @id @default(uuid())
  fecha          DateTime             @default(now())
  codigoItem     String
  // Fase 10: Decimal para trazar salidas/entradas de granel (0.5 kg),
  // recuentos con fracción y ajustes parciales.
  cantidadCambio Decimal              @db.Decimal(10, 3)
  // ENTRADA incrementa el stock, SALIDA lo decrementa; AJUSTE corrige
  // inventarios (recuento físico) con signo según la diferencia real.
  tipo           TipoMovimientoKardex
  motivo         String
  idUsuario      String

  producto Producto @relation(fields: [codigoItem], references: [codigoItem])
  usuario  Usuario  @relation(fields: [idUsuario], references: [idPersona])

  @@index([codigoItem, fecha])
  @@index([fecha])
  @@map("movimientos_kardex")
}

// Retiros parciales de efectivo de una caja (seguridad, transaccional):
// AL cerrar, el corte ciego resta estos montos del esperado para no
// marcar descuadre matemático.
model RetiroEfectivo {
  idRetiro  String   @id @default(uuid())
  idCaja    String
  idAdmin   String
  monto     Decimal  @db.Decimal(10, 2)
  motivo    String?
  fechaHora DateTime @default(now())
  createdAt DateTime @default(now())

  sesionCaja SesionCaja @relation(fields: [idCaja], references: [idCaja])
  admin      Usuario    @relation("RetiroAutorizadoPor", fields: [idAdmin], references: [idPersona])

  @@index([idCaja])
  @@index([fechaHora])
  @@map("retiros_efectivo")
}
